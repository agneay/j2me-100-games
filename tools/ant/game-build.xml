<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared build logic imported by every games/NNN-slug/build.xml.

  Targets
    dist   compile (ECJ, CLDC 1.0 / MIDP 2.0, preverified) + icon + JAR + JAD
    test   run the JAR on the headless reference runtime at 5 screen sizes
    media  capture website screenshots and a gameplay GIF
    web    compile the same sources to JavaScript (TeaVM) for the browser demo
    clean

  A game folder only needs game.properties, src/ and a 3-line build.xml.
-->
<project name="game-build">
    <dirname property="gamebuild.dir" file="${ant.file.game-build}"/>
    <property name="repo.root" location="${gamebuild.dir}/../.."/>
    <property name="lib.dir" location="${repo.root}/tools/lib"/>
    <property name="tools.jar" location="${repo.root}/tools/build/emu-desktop.jar"/>
    <property file="game.properties"/>
    <property name="build.dir" location="build"/>
    <property name="dist.dir" location="dist"/>
    <property name="vendor" value="J2ME Game Archive"/>
    <property name="game.test.script" value="default"/>
    <property name="game.demo.script" value="w500 shot:title 5 w500 gif:start rand:6000 gif:stop:demo shot:play"/>
    <!-- fixed timestamp so JARs are byte-for-byte reproducible -->
    <property name="jar.mtime" value="1767225600000"/>

    <fail unless="game.name" message="game.properties is missing game.name"/>
    <fail unless="game.jar" message="game.properties is missing game.jar"/>
    <fail unless="game.midlet" message="game.properties is missing game.midlet"/>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="-tools-check">
        <available file="${tools.jar}" property="tools.present"/>
    </target>

    <target name="tools" depends="-tools-check" unless="tools.present">
        <ant antfile="${repo.root}/build.xml" target="tools" inheritAll="false" useNativeBasedir="true"/>
    </target>

    <target name="compile">
        <delete dir="${build.dir}/classes"/>
        <mkdir dir="${build.dir}/classes"/>
        <java jar="${lib.dir}/ecj-3.26.0.jar" fork="true" failonerror="true">
            <arg line="-source 1.3 -target cldc1.1 -g:none -nowarn -encoding UTF-8"/>
            <arg value="-bootclasspath"/>
            <arg value="${lib.dir}/cldcapi10-2.0.4.jar${path.separator}${lib.dir}/midpapi20-2.0.4.jar"/>
            <arg value="-sourcepath"/>
            <arg value="src${path.separator}${repo.root}/common/src"/>
            <arg value="-d"/>
            <arg value="${build.dir}/classes"/>
            <arg value="src"/>
        </java>
    </target>

    <target name="icon" depends="tools">
        <mkdir dir="${build.dir}/res"/>
        <java classname="emu.desktop.IconGen" classpath="${tools.jar}" fork="true" failonerror="true">
            <sysproperty key="java.awt.headless" value="true"/>
            <arg value="${game.name}"/>
            <arg value="${game.category}"/>
            <arg value="${build.dir}/res/icon.png"/>
        </java>
    </target>

    <target name="dist" depends="compile,icon" description="Build JAR + JAD">
        <mkdir dir="${dist.dir}"/>
        <delete file="${dist.dir}/${game.jar}.jar"/>
        <jar destfile="${dist.dir}/${game.jar}.jar" modificationtime="${jar.mtime}" level="9">
            <manifest>
                <attribute name="MIDlet-Name" value="${game.name}"/>
                <attribute name="MIDlet-Version" value="${game.version}"/>
                <attribute name="MIDlet-Vendor" value="${vendor}"/>
                <attribute name="MIDlet-Description" value="${game.summary}"/>
                <attribute name="MIDlet-Icon" value="/icon.png"/>
                <attribute name="MIDlet-1" value="${game.name}, /icon.png, ${game.midlet}"/>
                <attribute name="MicroEdition-Profile" value="MIDP-2.0"/>
                <attribute name="MicroEdition-Configuration" value="CLDC-1.0"/>
            </manifest>
            <fileset dir="${build.dir}/classes"/>
            <fileset dir="${build.dir}/res"/>
        </jar>
        <length file="${dist.dir}/${game.jar}.jar" property="jar.size"/>
        <echo file="${dist.dir}/${game.jar}.jad" encoding="UTF-8">MIDlet-1: ${game.name}, /icon.png, ${game.midlet}
MIDlet-Description: ${game.summary}
MIDlet-Icon: /icon.png
MIDlet-Jar-Size: ${jar.size}
MIDlet-Jar-URL: ${game.jar}.jar
MIDlet-Name: ${game.name}
MIDlet-Vendor: ${vendor}
MIDlet-Version: ${game.version}
MicroEdition-Configuration: CLDC-1.0
MicroEdition-Profile: MIDP-2.0
</echo>
        <echo message="${game.name}: ${dist.dir}/${game.jar}.jar (${jar.size} bytes)"/>
    </target>

    <target name="test" depends="dist" description="Smoke-test on the headless reference runtime">
        <java classname="emu.desktop.Harness" classpath="${tools.jar}" fork="true" failonerror="true">
            <sysproperty key="java.awt.headless" value="true"/>
            <arg value="--jad"/>
            <arg value="${dist.dir}/${game.jar}.jad"/>
            <arg value="--out"/>
            <arg value="${build.dir}/test"/>
            <arg value="--report"/>
            <arg value="${build.dir}/test/report.json"/>
            <arg value="--script"/>
            <arg value="${game.test.script}"/>
        </java>
    </target>

    <target name="media" depends="dist" description="Screenshots + gameplay GIF for the website">
        <java classname="emu.desktop.Harness" classpath="${tools.jar}" fork="true" failonerror="true">
            <sysproperty key="java.awt.headless" value="true"/>
            <arg value="--jad"/>
            <arg value="${dist.dir}/${game.jar}.jad"/>
            <arg value="--out"/>
            <arg value="${build.dir}/media"/>
            <arg value="--sizes"/>
            <arg value="176x208"/>
            <arg value="--script"/>
            <arg value="${game.demo.script}"/>
        </java>
    </target>

    <!-- TeaVM 0.10 reads JDK class files with ASM 9.7, so it must run on JDK 17-21.
         Override with TEAVM_JAVA=/path/to/java, or drop a JRE 21 into tools/jre21. -->
    <property environment="env"/>
    <condition property="teavm.java" value="${env.TEAVM_JAVA}">
        <isset property="env.TEAVM_JAVA"/>
    </condition>
    <condition property="teavm.java" value="${repo.root}/tools/jre21/bin/java">
        <or>
            <available file="${repo.root}/tools/jre21/bin/java.exe"/>
            <available file="${repo.root}/tools/jre21/bin/java"/>
        </or>
    </condition>
    <property name="teavm.java" value="java"/>

    <target name="web" depends="tools" description="Compile the game to JavaScript for the browser demo">
        <delete dir="${build.dir}/web-classes"/>
        <mkdir dir="${build.dir}/web-classes"/>
        <mkdir dir="${build.dir}/web-gen/emu/web"/>
        <echo file="${build.dir}/web-gen/emu/web/WebMain.java">package emu.web;

public final class WebMain {
    public static void main(String[] args) {
        WebBackend.run(new ${game.midlet}());
    }
}
</echo>
        <javac destdir="${build.dir}/web-classes" includeantruntime="false" release="8" encoding="UTF-8"
               debug="false" nowarn="true" fork="true">
            <src path="src"/>
            <src path="${repo.root}/common/src"/>
            <src path="${repo.root}/emu/core/src"/>
            <src path="${repo.root}/emu/web/src"/>
            <src path="${build.dir}/web-gen"/>
            <compilerarg value="-Xlint:-options"/>
            <classpath>
                <fileset dir="${lib.dir}/teavm" includes="teavm-jso-*.jar,teavm-interop-*.jar"/>
            </classpath>
        </javac>
        <java classname="TeaBuild" fork="true" failonerror="true" jvm="${teavm.java}">
            <classpath>
                <pathelement location="${repo.root}/tools/build/teabuild"/>
                <fileset dir="${lib.dir}/teavm" includes="*.jar"/>
            </classpath>
            <arg value="${build.dir}/web-classes"/>
            <arg value="${build.dir}/web"/>
            <arg value="emu.web.WebMain"/>
        </java>
    </target>
</project>
